# EditorConfig is awesome: https://EditorConfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C and header files use Linux kernel style
[*.{c,h}]
indent_style = tab
indent_size = 8
tab_width = 8
max_line_length = 80

# Makefiles require real tabs
[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

[*.nix]
indent_style = tab
indent_size = 8
tab_width = 8

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2
max_line_length = 100
