+/*
+ * SPDX-FileCopyrightText: 2026 Wendell Conrad Richmond
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef UT_ARGC_H__
+#define UT_ARGC_H__
+
+#include LIB_VARARGS
+
+// taken from Dan Fabulich on stackoverflow
+
+// takes any arguments and gets the number of arguments
+// only counts up to 125 (the C99 standard limit of 127 - 2)
+// does this to reserve one argument for count and the other for ellipsis
+// implementations technically violate this arg limit
+// reasonably no sane person should ever reach this limit
+
+#define UT_ARGC(...) UT_ARGC_VWRAPPER_(__VA_ARGS__, UT_ARGC_R125_())
+
+#define UT_ARGC_VWRAPPER_(...) UT_ARGC_125_(__VA_ARGS__)
+
+#define UT_ARGC_125_(                                                          \
+	_1, _2, _3, _4, _5, _6, _7, _8, _9, _10, _11, _12, _13, _14, _15, _16, \
